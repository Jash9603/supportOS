# ─────────────────────────────────────────────────────
# SupportOS — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────

# ── PostgreSQL (Docker local) ─────────────────────────
DATABASE_URL=postgresql+asyncpg://supportos:supportos@localhost:5432/supportos

# ── Redis (Redis Cloud — DB: supportOS) ───────────────
# Format: redis://:<password>@<host>:<port>
# or for TLS: rediss://:<password>@<host>:<port>
REDIS_URL=redis://:<your-redis-password>@<your-redis-host>:<your-redis-port>

# ── Qdrant Cloud ──────────────────────────────────────
# Example: https://xyz-abc.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_URL=https://<your-cluster-url>.qdrant.io:6333
QDRANT_API_KEY=<your-qdrant-api-key>

# ── OpenAI ────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Auth ──────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# ── LangSmith (optional for MVP) ──────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=supportos-mvp
